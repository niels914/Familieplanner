# Zet deze waarden in Netlify onder: Site configuration → Environment variables.
# Voor lokaal ontwikkelen mag je ze in een .env-bestand zetten (dat staat in .gitignore).

# Supabase: de opslag van alle gegevens. Zie README, stap "Opslag in Supabase".
# Project URL, te vinden onder Project Settings → API.
SUPABASE_URL=
# De GEHEIME sleutel (service_role / secret key). Niet de publieke anon-sleutel.
# Geeft volledige toegang tot de database: alleen hier, nooit in de code.
SUPABASE_SERVICE_ROLE_KEY=

# Het gedeelde wachtwoord waarmee jullie inloggen.
FAMILY_PASSWORD=

# Willekeurige lange tekst waarmee sessiecookies ondertekend worden.
# Genereer er een met: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# De iCal-link uit Parro. Behandel deze als een wachtwoord: wie hem heeft,
# kan de volledige schoolagenda lezen.
PARRO_ICS_URL=

# Persoonlijke agenda's, alleen lezen. In Google Agenda: instellingen voor je agenda →
# Agenda integreren → "Geheim adres in iCal-indeling". Ook deze links zijn een
# wachtwoord: wie ze heeft, leest de hele agenda. Leeg laten = niet gekoppeld.
NIELS_ICS_URL=
IRENE_ICS_URL=

# Uitlezen uit foto of tekst (Nieuw → Uitlezen). De API-sleutel van Anthropic, van
# console.anthropic.com. Alleen in Netlify, nooit in de code. Leeg = de knop staat er niet.
ANTHROPIC_API_KEY=
# Optioneel: een andere modelnaam, bijvoorbeeld een snellere bij een time-out.
ANTHROPIC_MODEL=

# Sleutels voor pushmeldingen, te maken met: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:jouw@email.nl
